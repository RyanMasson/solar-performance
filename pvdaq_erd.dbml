// PVDAQ Database Schema
// Paste this into dbdiagram.io to generate an ERD

Table pvdaq_site {
  site_id varchar [primary key, note: 'primary key of the site']
  system_id bigint [note: 'associated system']
  public_name varchar [note: 'unique given name to the site']
  location varchar [note: 'text descriptive name of site location']
  latitude varchar [note: 'decimal latitude geo location']
  longitude varchar [note: 'decimal longitude geo location']
  elevation varchar [note: 'distance in meters above sea level, if known']
  av_pressure varchar [note: 'average annual atmospheric pressure at site in psi']
  av_temp varchar [note: 'average ambient temperature in degrees Celsius at site']
  climate_type varchar [note: 'Koppen-Geiger classifier for the site location']
}

Table pvdaq_system {
  system_id bigint [primary key, note: 'primary key of the system']
  site_id bigint [note: 'associated site representing geolocation details for system']
  public_name varchar [note: 'unique name given to the array']
  area varchar [note: 'covered area of the array in square meters']
  power varchar [note: 'maximum calculated or nameplate DC power of the array in kW']
  started_on varchar [note: 'date system became active']
  ended_on varchar [note: 'day system was deactivated']
  comments varchar [note: 'any additional details']
}

Table pvdaq_inverters {
  inverter_id varchar [primary key, note: 'database primary key']
  name varchar [note: 'alias given to the inverter by the array owner or autogenerated']
  manufacturer varchar
  model varchar
  serial_num varchar
  num_strings varchar [note: 'how many strings are tied to the inverter']
  modules_per_string varchar [note: 'how many modules are tied to each string']
  type varchar [note: 'indicates type of inverter such as micro, string, central, etc.']
  quantity varchar [note: 'number of inverters fielded at the array site']
  time_interval varchar [note: 'left(L), center(C), or right(R) aligned acquisition interval']
  site_id varchar [note: 'associated site']
  system_id bigint [note: 'associated system']
  comments varchar [note: 'any additional details']
}

Table pvdaq_meters {
  meter_id varchar [primary key, note: 'primary key of the meter']
  name varchar [note: 'alias given to the meter by the array owner or autogenerated']
  manufacturer varchar
  model varchar
  serial_num varchar
  time_interval varchar [note: 'left(L), center(C), or right(R) aligned acquisition interval']
  type varchar [note: 'type of the meter: production, site or revenue']
  site_id varchar [note: 'associated site']
  system_id bigint [note: 'associated system']
  comments varchar [note: 'any additional details']
}

Table pvdaq_modules {
  module_id varchar [primary key, note: 'the module primary key']
  name varchar [note: 'alias given to the module by the array owner or autogenerated']
  inverter_id varchar [note: 'associated inverter primary key tied to this module, if known']
  manufacturer varchar
  model varchar
  serial_num varchar
  type varchar [note: 'technology of the module: CdTe, Crystalline Si, multicrystalline Si, etc.']
  quantity varchar [note: 'number of modules installed on system']
  reference_module varchar [note: 'is this a reference module']
  start_on varchar [note: 'date module was installed']
  end_on varchar [note: 'date module was removed']
  site_id varchar [note: 'associated site']
  system_id bigint [note: 'associated system']
  comments varchar [note: 'any additional details']
}

Table pvdaq_mount {
  mount_id bigint [primary key, note: 'the primary key for the mount']
  name varchar [note: 'alias given to the mount by the array owner or autogenerated']
  manufacturer varchar
  model varchar
  azimuth varchar [note: 'pointing of the mount in compass direction decimal degrees']
  tilt varchar [note: 'angle of mount pointing in degrees']
  tracking varchar [note: 'is the mount tracking or fixed']
  type varchar [note: 'configuration of the mount: ground, roof, canopy, etc.']
  site_id varchar [note: 'associated site']
  system_id bigint [note: 'associated system']
  comments varchar [note: 'any additional details']
}

Table pvdaq_other_instruments {
  instrument_id varchar [primary key, note: 'the primary key of the instrument']
  name varchar [note: 'alias given to the other instrument by the array owner or autogenerated']
  manufacturer varchar
  model varchar
  serial_num varchar
  time_interval varchar [note: 'left(L), center(C), or right(R) aligned acquisition interval']
  type varchar [note: 'identifies the instrument: ref cell, weather station, thermocouple, etc.']
  site_id varchar [note: 'associated site']
  system_id bigint [note: 'associated system']
  comments varchar [note: 'any additional details']
}

Table pvdaq_metrics {
  metric_id int [primary key, note: 'primary key of the metric']
  system_id int [note: 'associated system for the metric']
  sensor_name varchar [note: 'referenced name produced by the instrumentation or tagged by array owner']
  common_name varchar [note: 'general grouping of sensor types (e.g. DC voltage, AC energy, POA irradiance)']
  raw_units varchar [note: 'raw unscaled or uncalibrated units of the values produced by the sensor']
  units varchar [note: 'units of the values produced by the sensor']
  calc_scale double [note: 'scaling for adjusting the sensor values (default 1)']
  calc_offset double [note: 'offset for adjusting the sensor values (default 0)']
  calc_details varchar [note: 'mathematical equation used to calculate the sensor value, if needed']
  aggregation_type varchar [note: 'avg, min, max, sample, union, median, or calculated']
  source_type varchar [note: 'what generates the sensor value (Inverters, meters or other instruments). Can be NULL']
  source_id int [note: 'associated primary key of the sensor type generating the value. Can be NULL']
  comments varchar [note: 'any additional details']
  standard_name varchar [note: 'unique autogenerated name']
}

Table pvdaq_pvdata {
  system_id varchar [note: 'associated system for the data (Partitioned)']
  measured_on timestamp [note: 'local timestamp as generated by the instrumentation']
  utc_measured_on timestamp [note: 'calculated UTC timestamp from the measured_on value']
  metric_id int [note: 'associated metric_id for the data']
  value double [note: 'value of the data']
}

// Relationships

Ref: pvdaq_system.site_id > pvdaq_site.site_id
Ref: pvdaq_site.system_id > pvdaq_system.system_id

Ref: pvdaq_inverters.site_id > pvdaq_site.site_id
Ref: pvdaq_inverters.system_id > pvdaq_system.system_id

Ref: pvdaq_meters.site_id > pvdaq_site.site_id
Ref: pvdaq_meters.system_id > pvdaq_system.system_id

Ref: pvdaq_modules.site_id > pvdaq_site.site_id
Ref: pvdaq_modules.system_id > pvdaq_system.system_id
Ref: pvdaq_modules.inverter_id > pvdaq_inverters.inverter_id

Ref: pvdaq_mount.site_id > pvdaq_site.site_id
Ref: pvdaq_mount.system_id > pvdaq_system.system_id

Ref: pvdaq_other_instruments.site_id > pvdaq_site.site_id
Ref: pvdaq_other_instruments.system_id > pvdaq_system.system_id

Ref: pvdaq_metrics.system_id > pvdaq_system.system_id

Ref: pvdaq_pvdata.system_id > pvdaq_system.system_id
Ref: pvdaq_pvdata.metric_id > pvdaq_metrics.metric_id

// Note: pvdaq_metrics.source_id is a polymorphic reference — it can point to
// pvdaq_inverters, pvdaq_meters, or pvdaq_other_instruments depending on the
// value of source_type. DBML doesn't support conditional/polymorphic FKs,
// so no direct Ref is created for source_id; the relationship is documented
// here instead.
